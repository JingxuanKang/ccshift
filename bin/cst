#!/bin/bash
# cst — 给 Claude Code 挂上可点击的换挡面板（tmux 分屏 TUI）
#
#   在 tmux 里、claude 所在 pane 中运行:  cst      → 底部弹出换挡面板
#   在 tmux 外运行:                       cst      → 新建 tmux 会话(claude + 面板)并接入
#
# 面板纯鼠标操作: 点档位/拨片换挡, ● 关闭, ↻ 刷新快照; 不绑定任何键盘按键
set -euo pipefail

SELF="$(readlink -f "$0")"
PROJ="$(cd "$(dirname "$SELF")/.." && pwd)"
TUI="$PROJ/bin/model_shift_tui.py"
PANE_H="${CST_HEIGHT:-8}"

if [ -n "${TMUX:-}" ]; then
  TARGET="$(tmux display-message -p '#{pane_id}')"
  tmux set-option -g mouse on >/dev/null 2>&1 || true
  tmux split-window -v -l "$PANE_H" "python3 '$TUI' --target '$TARGET'"
  tmux select-pane -t "$TARGET"
else
  SESS="cc-$$"
  tmux new-session -d -s "$SESS" -c "$PWD" -x "$(tput cols)" -y "$(tput lines)" 'claude'
  tmux set-option -g mouse on >/dev/null 2>&1 || true
  TARGET="$(tmux display-message -t "$SESS" -p '#{pane_id}')"
  tmux split-window -t "$SESS" -v -l "$PANE_H" "python3 '$TUI' --target '$TARGET'"
  tmux select-pane -t "$TARGET"
  exec tmux attach -t "$SESS"
fi
