<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>uk.jingxuan.model-pin-guard</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PROJ__/bin/model-pin-guard.sh</string>
  </array>
  <key>WatchPaths</key>
  <array>
    <string>__HOME__/.claude/settings.json</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>1</integer>
  <key>StandardOutPath</key>
  <string>__PROJ__/logs/pin-guard.launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJ__/logs/pin-guard.launchd.log</string>
</dict>
</plist>
